# Hobbithole Dashboard Gitignore

# Personal/Sensitive Data
data/
import/
*.bak-*
ROADMAP.md
# Lab-only helper (LAN paths / Pingvin) — not product
croc-help.html
public/croc-help.html

# Admin Scripts & Infrastructure
pre-build.sh
push.sh
github-push.sh
hub-readme-sync.sh
sync-readme-from-changelog.py
privacy-scan.sh
.privacy-scan-allow
README_PIPELINE.md
README.dockerhub.md
README.dockerhub.config-api.md

# Snapshots & Backups
backups/
# template_index.html is TRACKED (release UI, LAB_ONLY stripped).
# Lab dogfood edits public/index.html via compose map-mount — keep that OUT of GitHub.
public/index.html
template_docker-compose.yml

# Lab compose — absolute /root mounts + oauth env_file. NOT for GitHub.
# Consumers: docker-compose.hub.yml (tracked) or template_docker-compose.yml (lab).
docker-compose.yml

# Node.js
node_modules/
npm-debug.log

# Raw/Source media (not for public repo)
images/Bron/
images/Scherm*
public/images/Bron/
public/images/Scherm*

# Never ship chat/session dumps or lab raw assets
public/i18n/logs.json
i18n/logs.json
